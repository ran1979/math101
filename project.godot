; Engine configuration file.
config_version=5

[application]
config/name="Multiply Quest"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Save="*res://scripts/save_manager.gd"
Questions="*res://scripts/question_manager.gd"
Audio="*res://scripts/audio_manager.gd"
Game="*res://scripts/game_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.07, 0.2, 1)
anti_aliasing/quality/msaa_2d=1
